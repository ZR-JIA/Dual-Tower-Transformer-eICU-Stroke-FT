.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Abstra
.abstra/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ============================================================================
# Project-Specific Rules
# ============================================================================

# --- Data files (DUA compliance: raw/processed data must NOT be committed) ---
data/train_ready/*.csv
data/train_ready/*.parquet
data/train_ready/*.pkl
data/raw/
data/processed/
data/**/*.csv
data/**/*.parquet
src/**/*.csv
**/*pred*.csv

# --- Experiment trackers ---
mlruns/
wandb/

# --- Model outputs & experiment artifacts ---
outputs/

# --- Optuna databases ---
src/train/optuna/*.db

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- PDF files (papers, reports — do not commit to code repo) ---
*.pdf

# --- Internal planning / scratch docs ---
github.md
*_design_notes.md
*_notes.md
*_plan.md
progress.txt
scratch.md
todo.md
REFERENCES.md
PAPER_SOURCE.md

